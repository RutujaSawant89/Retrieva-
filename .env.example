# Retrieva configuration.
#  - Docker Compose: copy to ./.env (next to docker-compose.yml).
#  - Local development without Docker: backend/.env is written by `scripts/dev_db.py`;
#    add any of the application settings below to it.
# Never commit real secrets.

# ---------------------------------------------------------------- Compose secrets (required)
POSTGRES_PASSWORD=change-me-owner-password
APP_DB_PASSWORD=change-me-app-password
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-48-byte-random-secret
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ---------------------------------------------------------------- Deployment
ENVIRONMENT=production
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
# Secure cookies require HTTPS; set false only for plain-HTTP local testing.
COOKIE_SECURE=false
ALLOW_OPEN_REGISTRATION=true

# ---------------------------------------------------------------- Models
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RERANKER_PROVIDER=cross-encoder
# Models are baked into the image; keep the hub offline at runtime.
HF_OFFLINE=true

# ---------------------------------------------------------------- LLM provider
# extractive = no LLM (answers are verbatim cited sentences)
# openai     = any OpenAI-compatible API (OpenAI, Azure, Groq, vLLM, Ollama)
# anthropic  = Anthropic Messages API
LLM_PROVIDER=extractive
LLM_MODEL=
LLM_API_KEY=
# Ollama on the Docker host: http://host.docker.internal:11434/v1
LLM_BASE_URL=

# ---------------------------------------------------------------- Observability
OTEL_ENABLED=false
# With the monitoring profile: http://jaeger:4318/v1/traces
OTEL_EXPORTER_ENDPOINT=
