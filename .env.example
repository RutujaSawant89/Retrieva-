# Copy to backend/.env (local development) or .env (docker compose) and adjust.
# Never commit real secrets.

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=http://localhost:5173

# --- Database ---
# Runtime role: non-superuser without BYPASSRLS so Row-Level Security is enforced.
DATABASE_URL=postgresql+psycopg://retrieva_app:change-me@localhost:5432/retrieva
# Schema owner, used only by Alembic migrations.
MIGRATION_DATABASE_URL=postgresql+psycopg://retrieva:change-me@localhost:5432/retrieva

# --- Redis / Celery (leave REDIS_URL empty and set eager mode to run without Redis) ---
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# --- Security ---
JWT_SECRET=generate-with-python-c-import-secrets-print-secrets-token-urlsafe-48
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
ALLOW_OPEN_REGISTRATION=true

# --- Uploads ---
MAX_UPLOAD_MB=50
